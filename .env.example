# Copy to .env (gitignored) or set the same names in Vercel env.
# Never put real keys or credit codes in this file.

# Cognee Cloud REST — copy from the API Keys page Connection Details card.
# https://docs.cognee.ai/cognee-cloud/http-api
# TBC talks to Cloud over HTTP (httpx). Do not install the cognee Python package
# in the Vercel API bundle. Graph memory lives in Cognee Cloud.
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
# Connection Details user id. Not an API key; do not put this in COGNEE_API_KEY.
COGNEE_USER_ID=

# Cognee Cloud Billing coupon (hackathon / voucher). Redeem in the UI:
# Cognee Cloud → profile → Billing → Have a code?
# This is not an API key. Do not put it in COGNEE_API_KEY.
# Example coupon name used in this hackathon: GROKBOT35
# After redeeming, create an API key, then:
#   vercel env add COGNEE_SERVICE_URL
#   vercel env add COGNEE_API_KEY
# Hosted Grok Bot MCP (https://mcp.aws.cognee.ai/mcp) uses Cognee account
# sign-in, not this value.
COGNEE_CREDIT_CODE=
