{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web"
    },
    "api": {
      "root": "api",
      "entrypoint": "main:app",
      "installCommand": "pip install -r requirements.txt",
      "rewrites": [
        { "source": "/backend/:path(.*)?", "destination": "/:path" }
      ]
    }
  },
  "rewrites": [
    { "source": "/backend/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
